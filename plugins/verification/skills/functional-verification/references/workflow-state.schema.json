{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dv-agents:schema:workflow-state:1.0",
  "title": "DV workflow state",
  "description": "Durable state owned by the main orchestration agent and maintained by dv_flow.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_revision",
    "run_id",
    "created_at",
    "updated_at",
    "design",
    "workflow_status",
    "current_phase",
    "phase_status",
    "priority_order",
    "retry_limits",
    "tasks",
    "work_items",
    "artifacts",
    "baseline_revision",
    "accepted_revision",
    "frozen_revision",
    "plan_inventory",
    "blockers",
    "fix_requests",
    "approvals",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": "dv-flow/1.0"
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "workflow_status": {
      "enum": ["RUNNING", "WAITING_HUMAN", "BLOCKED", "COMPLETE"]
    },
    "current_phase": {
      "$ref": "#/$defs/phase"
    },
    "phase_status": {
      "enum": ["PENDING", "IN_PROGRESS", "PASSED"]
    },
    "priority_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retry_limits": {
      "$ref": "#/$defs/retryLimits"
    },
    "tasks": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/task"
      }
    },
    "work_items": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workItem"
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/revision"
      },
      "additionalProperties": {
        "$ref": "#/$defs/artifactSet"
      }
    },
    "baseline_revision": {
      "$ref": "#/$defs/revision"
    },
    "accepted_revision": {
      "$ref": "#/$defs/nullableRevision"
    },
    "frozen_revision": {
      "$ref": "#/$defs/nullableRevision"
    },
    "plan_inventory": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/statePlanInventory"
        }
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflowBlocker"
      }
    },
    "fix_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixRequest"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableIdentifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableRevision": {
      "oneOf": [
        {
          "$ref": "#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "spec", "rtl_filelist", "rtl_roots", "top"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "$ref": "#/$defs/path"
        },
        "rtl_filelist": {
          "$ref": "#/$defs/path"
        },
        "rtl_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "top": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "phase": {
      "enum": [
        "INIT",
        "PLAN",
        "PREFLIGHT",
        "SMOKE",
        "FEATURES",
        "RANDOM",
        "COVERAGE",
        "REGRESSION",
        "SIGNOFF",
        "WAITING_HUMAN",
        "BLOCKED",
        "COMPLETE"
      ]
    },
    "role": {
      "enum": ["builder", "reviewer", "runner"]
    },
    "action": {
      "enum": [
        "WRITE_VPLAN",
        "BUILD_SMOKE_FOUNDATION",
        "IMPLEMENT_FEATURE_BATCH",
        "APPLY_REVIEW_FIX",
        "APPLY_DEBUG_FIX",
        "COVERAGE_CLOSURE",
        "REVIEW_VPLAN",
        "REVIEW_TB",
        "REVIEW_FIX",
        "SIGNOFF_AUDIT",
        "PREFLIGHT",
        "COMPILE_ELAB",
        "RUN_CASE",
        "RUN_REGRESSION",
        "MERGE_COVERAGE"
      ]
    },
    "retryKind": {
      "enum": [
        "dispatch",
        "review",
        "environment",
        "tb-fix",
        "debug-evidence",
        "none"
      ]
    },
    "retryLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch",
        "review",
        "environment",
        "tb-fix",
        "debug-evidence",
        "none"
      ],
      "properties": {
        "dispatch": {
          "const": 3
        },
        "review": {
          "const": 3
        },
        "environment": {
          "const": 3
        },
        "tb-fix": {
          "const": 3
        },
        "debug-evidence": {
          "const": 2
        },
        "none": {
          "const": 1
        }
      }
    },
    "taskStatus": {
      "enum": ["DRAFT", "READY", "COMPLETED", "BLOCKED", "FAILED"]
    },
    "outcome": {
      "enum": [
        "READY_FOR_REVIEW",
        "NO_CHANGE",
        "APPROVED",
        "CHANGES_REQUIRED",
        "PASS",
        "COVERAGE_GAP",
        "ENVIRONMENT_ERROR",
        "COMPILE_ERROR",
        "ELABORATION_ERROR",
        "SIMULATION_FAILURE",
        "TIMEOUT",
        "BLOCKED",
        "INTERNAL_ERROR"
      ]
    },
    "nullableOutcome": {
      "oneOf": [
        {"$ref": "#/$defs/outcome"},
        {"type": "null"}
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "run_id",
        "lineage_id",
        "retry_kind",
        "attempt",
        "role",
        "action",
        "phase",
        "status",
        "input_revision",
        "output_revision",
        "parent_task_id",
        "request_path",
        "result_path",
        "request_sha256",
        "result_sha256",
        "protected_paths",
        "write_scope_before",
        "outcome",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "lineage_id": {
          "$ref": "#/$defs/identifier"
        },
        "retry_kind": {
          "$ref": "#/$defs/retryKind"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "status": {
          "$ref": "#/$defs/taskStatus"
        },
        "input_revision": {
          "$ref": "#/$defs/nullableRevision"
        },
        "output_revision": {
          "$ref": "#/$defs/nullableRevision"
        },
        "parent_task_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "request_path": {
          "$ref": "#/$defs/path"
        },
        "result_path": {
          "$ref": "#/$defs/path"
        },
        "request_sha256": {
          "$ref": "#/$defs/nullableRevision"
        },
        "result_sha256": {
          "$ref": "#/$defs/nullableRevision"
        },
        "protected_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "write_scope_before": {
          "$ref": "#/$defs/digestMap"
        },
        "outcome": {
          "$ref": "#/$defs/nullableOutcome"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "builder"
              }
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "WRITE_VPLAN",
                  "BUILD_SMOKE_FOUNDATION",
                  "IMPLEMENT_FEATURE_BATCH",
                  "APPLY_REVIEW_FIX",
                  "APPLY_DEBUG_FIX",
                  "COVERAGE_CLOSURE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "reviewer"
              }
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "REVIEW_VPLAN",
                  "REVIEW_TB",
                  "REVIEW_FIX",
                  "SIGNOFF_AUDIT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "runner"
              }
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "PREFLIGHT",
                  "COMPILE_ELAB",
                  "RUN_CASE",
                  "RUN_REGRESSION",
                  "MERGE_COVERAGE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "DRAFT"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "request_sha256": {"type": "null"},
              "result_sha256": {"type": "null"},
              "output_revision": {"type": "null"},
              "outcome": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "READY"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "request_sha256": {"$ref": "#/$defs/revision"},
              "result_sha256": {"type": "null"},
              "outcome": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"enum": ["COMPLETED", "BLOCKED", "FAILED"]}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "request_sha256": {"$ref": "#/$defs/revision"},
              "result_sha256": {"$ref": "#/$defs/revision"},
              "outcome": {"$ref": "#/$defs/outcome"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "BLOCKED"}},
            "required": ["status"]
          },
          "then": {"properties": {"outcome": {"const": "BLOCKED"}}}
        },
        {
          "if": {
            "properties": {"status": {"const": "FAILED"}},
            "required": ["status"]
          },
          "then": {"properties": {"outcome": {"const": "INTERNAL_ERROR"}}}
        },
        {
          "if": {
            "properties": {"status": {"const": "COMPLETED"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "outcome": {"not": {"enum": ["BLOCKED", "INTERNAL_ERROR"]}}
            }
          }
        }
      ]
    },
    "workItemStatus": {
      "enum": [
        "PENDING",
        "BUILDING",
        "AWAITING_REVIEW",
        "CHANGES_REQUIRED",
        "READY_TO_RUN",
        "RUNNING",
        "DEBUGGING",
        "FIXING",
        "PASSED",
        "BLOCKED_DUT",
        "BLOCKED_SPEC",
        "WAIVED",
        "TERMINAL_FAILURE"
      ]
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "priority",
        "mandatory",
        "status",
        "dependencies",
        "accepted_revision",
        "builder_task_id",
        "review_task_id",
        "run_task_id",
        "evidence_task_ids",
        "last_task_id",
        "reason",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["FEATURE", "TEST", "COVERAGE"]
        },
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/workItemStatus"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "last_task_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "mandatory": {
          "type": "boolean"
        },
        "accepted_revision": {
          "$ref": "#/$defs/revision"
        },
        "builder_task_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "review_task_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "run_task_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "evidence_task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "reason": {
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "artifactSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_task_id",
        "producer_task_ids",
        "paths",
        "digests",
        "recorded_at"
      ],
      "properties": {
        "producer_task_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "producer_task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "digests": {
          "$ref": "#/$defs/digestMap",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/path"
          }
        },
        "files": {
          "$ref": "#/$defs/fileManifest"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "digestMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/path"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "fileManifest": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/path"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "mtime_ns", "size"],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "mtime_ns": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "statePlanInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority_order",
        "items",
        "random_campaigns",
        "coverage_items",
        "review_task_id",
        "source_revision"
      ],
      "properties": {
        "priority_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planItem"
          }
        },
        "random_campaigns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/randomCampaign"
          }
        },
        "coverage_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageItem"
          }
        },
        "review_task_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "planItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "priority", "dependencies", "mandatory"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["FEATURE", "TEST"]},
        "priority": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "mandatory": {"type": "boolean"}
      }
    },
    "randomCampaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "test", "seed_budget", "dependencies", "mandatory"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "test": {"$ref": "#/$defs/identifier"},
        "seed_budget": {"type": "integer", "minimum": 1},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "mandatory": {"type": "boolean"}
      }
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "target", "dependencies", "mandatory"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "metric": {"type": "string", "minLength": 1},
        "target": {"type": "number"},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "mandatory": {"type": "boolean"}
      }
    },
    "workflowBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "summary",
        "related_ids",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "DUT",
            "SPEC",
            "ENVIRONMENT",
            "UNKNOWN",
            "RETRY_EXHAUSTED",
            "HUMAN_GATE"
          ]
        },
        "status": {
          "enum": ["OPEN", "RESOLVED", "WAIVED"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "related_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "resolved_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fixRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "classification",
        "failure_task_id",
        "summary",
        "affected_ids",
        "evidence",
        "previous_revision",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": ["OPEN"]
        },
        "classification": {
          "const": "DUT_BUG"
        },
        "failure_task_id": {
          "$ref": "#/$defs/identifier"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "affected_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "previous_revision": {"$ref": "#/$defs/revision"},
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "decision",
        "approved_by",
        "note",
        "revision",
        "timestamp"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": ["APPROVED", "REJECTED", "WAIVED"]
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/nullableRevision"
        },
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_seq",
        "timestamp",
        "run_id",
        "kind",
        "details"
      ],
      "properties": {
        "schema_version": {
          "const": "dv-flow/1.0"
        },
        "event_seq": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
